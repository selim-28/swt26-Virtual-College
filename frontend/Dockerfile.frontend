# Bauphase: Node installiert die Abhaengigkeiten und baut die React-App.
FROM node:22-alpine AS build

WORKDIR /app

# Erst die Paketdateien kopieren, damit Docker den Installationsschritt cachen kann.
COPY package*.json ./

RUN npm install

COPY index.html ./index.html
COPY src ./src

RUN npm run build

# Laufzeitphase: Nginx liefert die gebauten Dateien aus und proxyt die Backends.
FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=build /app/dist /usr/share/nginx/html
