<!--
  Das ist die ZENTRALE pom.xml (das "Eltern"-Projekt).
  Eine pom.xml ist die Steuerdatei fuer Maven (das Bau-Werkzeug).
  Sie sagt Maven: wie heisst das Projekt, welche Teile gehoeren dazu,
  welche Java-Version usw. Diese Datei baut selbst keinen Code,
  sondern haelt die beiden Backends zusammen.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Version des pom-Dateiformats. Ist bei Maven immer "4.0.0". -->
    <modelVersion>4.0.0</modelVersion>

    <!--
      "parent" = Wir erben Einstellungen von einem fertigen Projekt.
      Hier von Spring Boot. Dadurch kennt Maven schon die passenden
      Versionen aller Spring-Bibliotheken, und WIR muessen sie nicht
      selbst angeben.
    -->
    <parent>
        <!-- Hersteller/Gruppe der Eltern-Vorlage: das Spring-Team. -->
        <groupId>org.springframework.boot</groupId>
        <!-- Name der Eltern-Vorlage: die Spring-Boot-Starter-Vorlage. -->
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Welche Spring-Boot-Version wir benutzen. -->
        <version>4.0.6</version>
        <!-- Leer = Maven laedt die Eltern-Vorlage aus dem Internet. -->
        <relativePath/>
    </parent>

    <!-- Eindeutiger Gruppenname unseres Projekts (wie ein Nachname). -->
    <groupId>swt2.virtualcollege</groupId>
    <!-- Name genau dieses Projekts. -->
    <artifactId>virtual-college</artifactId>
    <!-- Versionsnummer. "SNAPSHOT" = noch in Entwicklung, nicht fertig. -->
    <version>1.0.0-SNAPSHOT</version>
    <!--
      "packaging = pom" bedeutet: diese Datei ist NUR eine Klammer/Sammelmappe.
      Sie enthaelt selbst keinen Code, sondern verweist auf die Module unten.
    -->
    <packaging>pom</packaging>

    <!-- Lesbarer Anzeigename des Projekts. -->
    <name>Virtual College</name>

    <!--
      "modules" = die Teil-Projekte, aus denen das Ganze besteht.
      Das sind EURE ZWEI BACKEND-SYSTEME aus dem Verteilungsdiagramm.
      Jeder Eintrag ist ein Ordnername mit eigener pom.xml.
    -->
    <modules>
        <!-- Backend 1: Application Server (liefert dem Frontend die Daten). -->
        <module>backend_receive</module>
        <!-- Backend 2: Fremdsystem (ÖPNV / Studierendenwerk). -->
        <module>backend_send</module>
    </modules>

    <!-- "properties" = allgemeine Einstellungen fuer das ganze Projekt. -->
    <properties>
        <!-- Wir programmieren mit Java in der Version 21. -->
        <java.version>21</java.version>
        <!-- Zeichensatz UTF-8, damit Umlaute (ä, ö, ü) korrekt sind. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
</project>
